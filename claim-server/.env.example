# Required: Ethereum private key (same as your Polymarket wallet)
POLYMARKET_PRIVATE_KEY=0x...

# Required: Builder API credentials
# Generate at https://polymarket.com/settings?tab=builder
POLYMARKET_BUILDER_API_KEY=
POLYMARKET_BUILDER_SECRET=
POLYMARKET_BUILDER_PASSPHRASE=

# Optional: seconds between claim cycles (default: 300 = 5 minutes)
# CLAIM_INTERVAL=300
