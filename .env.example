# Polymarket private key (hex, with or without 0x prefix).
# Used to derive the Safe wallet address and sign all CLOB orders.
POLYMARKET_PRIVATE_KEY=

# Builder API credentials for claiming/redeeming resolved positions.
# Obtain from Polymarket Builder dashboard.
POLYMARKET_BUILDER_API_KEY=
POLYMARKET_BUILDER_SECRET=
POLYMARKET_BUILDER_PASSPHRASE=

# -- Optional (claim-server) --

# Seconds between claim/redeem cycles (default: 900)
CLAIM_INTERVAL=900

# HTTP port for the claim-server web UI (default: 8080)
UI_PORT=8080
